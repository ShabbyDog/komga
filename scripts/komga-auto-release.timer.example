# ShabbyFork: run the release pipeline on a schedule.
#
# This file holds two units. Copy the timer section below into
# /etc/systemd/system/komga-auto-release.timer, and the service section (uncommented, paths
# edited) into /etc/systemd/system/komga-auto-release.service, then enable the timer:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now komga-auto-release.timer
#   systemctl list-timers komga-auto-release.timer
#
# Run the service as the user Komga itself runs as (`systemctl show -p User komga.service`),
# not as root. That user already owns the jar folder, keeps the build caches and the checkout
# owned by the same account, and is the one whose `gh auth login` the pipeline uses; root has
# none of that. Its only privileged step, stopping and starting komga.service, comes from the
# passwordless sudo rule described in auto-release.conf.example.

# ---------- /etc/systemd/system/komga-auto-release.timer ----------
[Unit]
Description=Check for a new upstream Komga release, build, release and upgrade

[Timer]
# Nightly, at a quiet hour, with jitter so it never lands on the same second.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target

# ---------- /etc/systemd/system/komga-auto-release.service ----------
# [Unit]
# Description=ShabbyFork automated release pipeline
# After=network-online.target
# Wants=network-online.target
#
# [Service]
# Type=oneshot
# # The user komga.service runs as; replace "komga" and the /home/komga paths to match.
# User=komga
# WorkingDirectory=/home/komga/src/komga
# Environment=KOMGA_AUTO_CONF=/home/komga/.config/komga-auto.conf
# # Gradle and npm need a writable HOME for their caches.
# Environment=HOME=/home/komga
# # A unit gets a minimal environment, so name the JDK rather than hoping PATH finds one. Gradle
# # compiles with the JVM it runs on, so this home must contain bin/javac, not just bin/java.
# Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# ExecStart=/bin/bash scripts/auto-release.sh
# # A build plus a migration on a large library can be slow; do not kill it half way.
# TimeoutStartSec=3h
