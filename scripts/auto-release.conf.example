# ShabbyFork: configuration for scripts/auto-release.sh
#
# Copy to ~/.config/komga-auto.conf (or point KOMGA_AUTO_CONF at it) and edit. It is kept
# outside the repository on purpose, so paths specific to one machine never reach the fork
# diff and never need rebasing.
#
#   install -Dm600 scripts/auto-release.conf.example ~/.config/komga-auto.conf
#   bash scripts/auto-release.sh --preflight
#
# The values below are examples. Find the real ones with:
#
#   systemctl list-units '*komga*'                      # the unit name
#   systemctl cat komga.service | grep ExecStart        # the jar it starts
#   find / -name database.sqlite 2>/dev/null            # the config directory
#
# Run the pipeline as the same user Komga runs as, not as root: it keeps the jar folder and
# the build caches owned by that user. The only thing it needs privileges for is stopping and
# starting the unit, so give that user a passwordless sudo rule for exactly that, in
# /etc/sudoers.d/komga-auto (visudo -f /etc/sudoers.d/komga-auto), substituting your own user:
#
#   youruser ALL=(root) NOPASSWD: /bin/systemctl start komga.service, \
#                                 /bin/systemctl stop komga.service, \
#                                 /bin/systemctl show komga.service
#
# Check the path first with `command -v systemctl`; it is /usr/bin/systemctl on some
# distributions. Note that `sudo` changes $HOME to /root, so if you do run this with sudo,
# pass the config explicitly:
#
#   sudo KOMGA_AUTO_CONF=$HOME/.config/komga-auto.conf bash scripts/auto-release.sh

# The systemd unit that runs Komga.
KOMGA_SERVICE=komga.service

# The jar the unit starts. The pipeline overwrites this file, and also drops the versioned
# jar next to it, so the folder keeps a history of what has run.
KOMGA_JAR=/opt/komga/komga.jar

# Where Komga keeps database.sqlite and tasks.sqlite, i.e. its --komga.config-dir. Defaults to
# ~/.komga when that option is not set. Backed up before every upgrade, together with the -wal
# and -shm sidecars, because Flyway migrations cannot be undone and a WAL must never be
# separated from its database.
KOMGA_CONFIG_DIR=/var/lib/komga

# Used for the post-upgrade health check. Must be reachable from the machine running this;
# localhost is the safer choice, since it does not break if the LAN address changes.
KOMGA_URL=http://localhost:25600

# Where jar and database backups are kept, and how many upgrades to keep them for. Must be
# writable by the user running the pipeline.
BACKUP_DIR=/var/backups/komga
KEEP_BACKUPS=3

# Where releases are published and failures are reported as issues. A fork has its issue
# tracker disabled by default; without it a failing unattended run has nowhere to report to.
#   gh repo edit <owner>/<repo> --enable-issues
GH_REPO=ShabbyDog/komga

# How long to wait for Komga to answer after an upgrade. A large library migrating a new
# schema can take minutes, so this is deliberately generous.
HEALTH_TIMEOUT=600

# Title of the issue used to report failures. One is open at a time.
ISSUE_TITLE='Automated release pipeline failed'

# Overlaps between a new upstream release and a fork feature are reported in an issue of their
# own, which the pipeline never closes.
OVERLAP_ISSUE_TITLE='Upstream overlaps a fork feature'

# Claude, via scripts/claude-assist.sh, before each upstream release is taken: it checks whether
# upstream now provides a fork feature (fully: our commits are dropped, upstream wins; partly: an
# overlap issue, nothing dropped), and resolves rebase conflicts it judges mechanical. It runs as
# the pipeline's user with that user's `claude auth login`, read-only apart from editing the
# conflicted files, and the pipeline verifies its work; the full tests still gate every release.
# Set CLAUDE_ASSIST=0 to release without it. Without a working claude the pipeline still releases,
# and says so in the release notes.
CLAUDE_ASSIST=1
# Use an absolute path: the systemd unit runs with the default PATH, which has no ~/.local/bin,
# so a bare `claude` is not found under the timer even though it works in a shell.
CLAUDE_BIN=$HOME/.local/bin/claude
CLAUDE_MODEL=claude-opus-5-5
# Seconds per Claude call, and how many conflicted commits one rebase may hand to it.
CLAUDE_TIMEOUT=1800
CLAUDE_MAX_CONFLICTS=10
# Full JSON transcript of every call, for audit.
CLAUDE_LOG_DIR=$HOME/.local/state/komga-auto-release
